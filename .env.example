# =============================================================
# Mivo — environment variables
#
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit real values. NEVER prefix a secret with NEXT_PUBLIC_
# (that prefix inlines the value into the browser bundle).
# =============================================================

# --- Database (required for the admin area) -------------------
# Postgres connection string. Neon / Vercel Postgres recommended.
DATABASE_URL=

# --- Authentication (required for the admin area) -------------
# Signing key for session cookies. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# The single authorised owner account. There is no public sign-up.
ADMIN_EMAIL=

# bcrypt hash of the owner password. Generate with:
#   npm run admin:hash
# Store the HASH here, never the plaintext password.
ADMIN_PASSWORD_HASH=

# --- Email notifications (optional) --------------------------
# Resend API key. Server-side only.
RESEND_API_KEY=
# Verified sender address, e.g. "Mivo <enquiries@yourdomain.com>"
EMAIL_FROM=
# Where new-enquiry notifications are delivered.
EMAIL_TO=

# --- Site configuration (optional) ---------------------------
# Public base URL, used in emails and metadata. Safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Salt used to hash visitor IPs before storing them for rate
# limiting. Raw IPs are never persisted. Generate with:
#   openssl rand -base64 32
IP_HASH_SALT=
